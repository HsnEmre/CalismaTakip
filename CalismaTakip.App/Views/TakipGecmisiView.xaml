<UserControl x:Class="CalismaTakip.Views.TakipGecmisiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Geçmiş / Takip Kayıtları"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Günlük takip kayıtlarınızı tarih aralığına göre görüntüleyin."
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Özet kartları -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <Border Margin="0,0,8,0"
                    Background="#F0F4FF"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Toplam kayıt günü"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding TotalRecordDays}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Background="#F0FDF4"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Ortalama günlük %"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding AverageDailyCompletionPercent, StringFormat={}{0:0.#}%}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Background="#FFFBEB"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="%100 tamamlanan gün"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding FullyCompletedDays}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Background="#FEF3C7"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Tamamlanan görev"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding TotalTasksCompleted}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#EEF2FF"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Planlanan görev"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding TotalTasksScheduled}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filtre -->
        <Border Grid.Row="2"
                Background="#FAFBFC"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Başlangıç"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="160"
                            Margin="0,0,20,0" />
                <TextBlock Text="Bitiş"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="160"
                            Margin="0,0,16,0" />
                <Button Content="Filtrele"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ApplyFilterCommand}"
                        MinWidth="100"
                        Padding="16,10"
                        Margin="0,0,8,0" />
                <Button Content="Temizle"
                        Style="{StaticResource NavButtonStyle}"
                        Command="{Binding ClearFilterCommand}"
                        MinWidth="100"
                        Padding="16,10" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="#B45309"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Tablo + detay -->
        <Grid Grid.Row="4" MinHeight="280">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih"
                                        Binding="{Binding DateDisplay}"
                                        Width="110"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="Görev (yapılan/toplam)"
                                        Binding="{Binding TaskRatioText}"
                                        Width="*" />
                    <DataGridTextColumn Header="Tamamlanma"
                                        Binding="{Binding PercentText}"
                                        Width="100" />
                    <DataGridTextColumn Header="Not"
                                        Binding="{Binding Note}"
                                        Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="MaxHeight" Value="72" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    Background="#FAFBFC"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Seçilen gün"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,12" />

                    <TextBlock DockPanel.Dock="Top"
                               Text="Bir satır seçin."
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSelectRowHint}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="16"
                                       Text="{Binding SelectedRow.DateDisplay}"
                                       Margin="0,0,0,12" />

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left"
                                           FontWeight="SemiBold"
                                           Text="Görev özeti: " />
                                <TextBlock Text="{Binding SelectedRow.TaskRatioText}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left"
                                           FontWeight="SemiBold"
                                           Text="Tamamlanma: " />
                                <TextBlock Text="{Binding SelectedRow.PercentText}"
                                           TextWrapping="Wrap" />
                            </DockPanel>

                            <TextBlock Text="Not"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding SelectedRow.Note, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="100"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="{StaticResource Brush.Border}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
