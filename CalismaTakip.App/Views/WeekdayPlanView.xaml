<UserControl x:Class="CalismaTakip.Views.WeekdayPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Hafta İçi Plan"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="Kaydet"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Margin="16,0,0,0"
                        MinWidth="100"
                        Padding="16,10" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.TextMuted}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Pazartesi–Cuma grid; hücreleri düzenleyip Kaydet ile SQLite'a yazın."
                   Foreground="{StaticResource Brush.TextMuted}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Rows}"
                  Margin="0,0,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Saat"
                                    Binding="{Binding TimeRangeLabel}"
                                    IsReadOnly="True"
                                    Width="128" />
                <DataGridTextColumn Header="Pazartesi"
                                    Binding="{Binding MondayActivity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Salı"
                                    Binding="{Binding TuesdayActivity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Çarşamba"
                                    Binding="{Binding WednesdayActivity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Perşembe"
                                    Binding="{Binding ThursdayActivity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Cuma"
                                    Binding="{Binding FridayActivity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
