<UserControl x:Class="CalismaTakip.Views.DailyTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Günlük Takip"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding DateHeaderLine}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,8,0,4" />
            <TextBlock Text="{Binding ActivePlanLabel}"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="14" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#F0F4FF"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Toplam görev"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding TotalTasks}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Yapılan"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding CompletedTasks}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tamamlanma"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding CompletionPercentDisplay}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tarih"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <DatePicker SelectedDate="{Binding SelectedDateUi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="200" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Planı şablondan yenile"
                        Style="{StaticResource NavButtonStyle}"
                        Command="{Binding ResetPlanCommand}"
                        Margin="0,0,8,0"
                        Padding="14,10" />
                <Button Content="Kaydet"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        MinWidth="100"
                        Padding="16,10" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Margin="0,0,0,8"
                   TextTrimming="CharacterEllipsis" />

        <DataGrid ItemsSource="{Binding PlanRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,12"
                  MinHeight="220">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RowBackground}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Saat"
                                    Binding="{Binding TimeRangeText}"
                                    IsReadOnly="True"
                                    Width="128" />
                <DataGridTextColumn Header="Görev / plan"
                                    Binding="{Binding Title}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridCheckBoxColumn Header="Yapıldı"
                                        Binding="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90" />
                <DataGridTextColumn Header="Durum"
                                    Binding="{Binding StatusText}"
                                    IsReadOnly="True"
                                    Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock DockPanel.Dock="Top"
                   Text="Günlük not"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <TextBox DockPanel.Dock="Bottom"
                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="120"
                 MaxLength="8000" />
    </DockPanel>
</UserControl>
