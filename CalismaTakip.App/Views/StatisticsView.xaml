<UserControl x:Class="CalismaTakip.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Aylık istatistikler"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="Seçili ay için kayıtlı günlerinizin özeti ve hedef dağılımı."
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="#FAFBFC"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="◀"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding PreviousMonthCommand}"
                            Padding="14,8"
                            MinWidth="48"
                            ToolTip="Önceki ay" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MonthTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="▶"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NextMonthCommand}"
                            Padding="14,8"
                            MinWidth="48"
                            ToolTip="Sonraki ay" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B45309"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Özet kartları -->
            <UniformGrid Columns="5" Margin="0,0,0,10">
                <Border Margin="0,0,8,10"
                        Background="#F0F4FF"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Kayıtlı gün"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.TotalRecordedDays}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,10"
                        Background="#F0FDF4"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Teknik (gün)"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.TechnicalDoneDays}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,10"
                        Background="#FFFBEB"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Speaking (gün)"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.SpeakingDoneDays}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,10"
                        Background="#FEF3C7"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Grammar (gün)"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.GrammarDoneDays}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,10"
                        Background="#EEF2FF"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Uyku (gün)"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.SleepDoneDays}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Border Margin="0,0,8,0"
                        Background="#F9FAFB"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Ortalama günlük %"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.AverageDailyCompletionPercent, StringFormat={}{0:0.#}%}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0"
                        Background="#ECFDF5"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="4/4 gün"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.FullCompletionDays}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0"
                        Background="#FEF2F2"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="0/4 gün"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.ZeroCompletionDays}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0"
                        Background="#EFF6FF"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="En iyi gün %"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.BestDayCompletionPercent, StringFormat={}{0:0.#}%}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#F5F3FF"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Toplam performans %"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Stats.TotalPerformancePercent, StringFormat={}{0:0.#}%}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Hedef dağılımı (kayıtlı günlere göre)"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Margin="0,0,0,10" />

            <StackPanel Margin="0,0,0,8">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Width="140" Text="Teknik çalışma" VerticalAlignment="Center" />
                    <ProgressBar Height="14"
                                 Maximum="100"
                                 Value="{Binding TechnicalSharePercent}"
                                 Foreground="#22C55E" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Width="140" Text="Speaking" VerticalAlignment="Center" />
                    <ProgressBar Height="14"
                                 Maximum="100"
                                 Value="{Binding SpeakingSharePercent}"
                                 Foreground="#EAB308" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Width="140" Text="Grammar" VerticalAlignment="Center" />
                    <ProgressBar Height="14"
                                 Maximum="100"
                                 Value="{Binding GrammarSharePercent}"
                                 Foreground="#F97316" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Width="140" Text="Uyku düzeni" VerticalAlignment="Center" />
                    <ProgressBar Height="14"
                                 Maximum="100"
                                 Value="{Binding SleepSharePercent}"
                                 Foreground="#6366F1" />
                </DockPanel>
            </StackPanel>

            <TextBlock Text="Özet çubukları"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Margin="0,12,0,10" />

            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Width="200" Text="Ortalama günlük tamamlama" TextWrapping="Wrap" />
                <ProgressBar Height="16" Maximum="100" Value="{Binding AverageCompletionBar}" Foreground="#2563EB" />
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Width="200" Text="Ay toplam performansı" TextWrapping="Wrap" />
                <ProgressBar Height="16" Maximum="100" Value="{Binding TotalPerformanceBar}" Foreground="#0D9488" />
            </DockPanel>
            <DockPanel Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Left" Width="200" Text="En başarılı gün (oran)" TextWrapping="Wrap" />
                <ProgressBar Height="16" Maximum="100" Value="{Binding BestDayBar}" Foreground="#7C3AED" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
